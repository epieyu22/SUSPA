<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Comprobante de pago</title>
  <style>
    body{
      font-family: "Arial";
      margin: 0;
      font-size: 14px;
      padding-bottom: 0;
      text-rendering: geometricPrecision;
    }
    .row .row{
      display: table;
    }

    .row {
      display: table;
      width: 100%;
    }
    .row div{
      display: table-cell;
      vertical-align: middle;
    }
    .row.padding{
      padding: 10px 0;
    }
    table{
      margin-top: 40px;
      border-collapse: collapse;
      border: 1px solid #ccc;
      font-size: 14px;
      text-align: right;
    }
    tr:nth-child(odd) {
      background-color: rgba(0,0,0,.05);
    }
    thead{
      background-color: #eef;
      font-weight: normal;
    }
    table th, table td{
      padding: 5px;
      border: 1px solid #ccc;
      vertical-align: middle;
    }
    .text-center{
      text-align: center;
    }
    .text-left{
      text-align: left;
    }
    .text-right{
      text-align: right;
    }
    hr{
      margin: 40px;
    }
    img{
      max-width: 100%;
    }
  </style>
</head>
<body class="row">
  <div class="row" style="page-break-before: always; padding: 30px">
    <div style="width: 15%;text-align: center;">
      <img src="@Model.general.logo">
    </div>
    <div style="vertical-align: top;">
      <hgruop class="text-right">
        <h3 style="margin-bottom: 5px; margin-top: 0;">@Model.general.razonSocial</h3>
        <h5 style="margin-top: 5px;font-weight: normal;">Nit: @Model.general.nit</h5>
      </hgruop>
    </div>
  </div>
  <div class="row padding">
    <div class="row">
      <h3>Fecha Nómina: @Model.general.fechaNomina</h3>
    </div>
    <div class="row">
      <div class="text-left" style="width: 20%"><b>Código Empleado:</b> @Model.empleado.Cod_Empleado</div>
      <div class="text-center" style="width: 40%"><b>Empleado:</b> @Model.empleado.Empleado</div>
      <div class="text-right" style="width: 20%"><b>Doc Identificación:</b> @Model.empleado.Cedula</div>
    </div>
    <div class="row">
      <div><b>Cargo:</b> @Model.general.cargo</div>
    </div>
    <div class="row">
      <div><b>Centro de Costo:</b> @Model.general.ccosto</div>
    </div>
    @if(@Model.empleado.Por_Retefuente != 0){
    <div class="row">
      <div><b>Porcentaje de retención en la fuente:</b> @Model.empleado.Por_Retefuente.ToString("N0") %</div>
      <div class="text-right"><b>Metodo de retención en la fuente:</b> @Model.empleado.MetodoRetefuente</div>
    </div>
    }
    <div class="row">
      <div><b>Salario:</b> $@Model.empleado.Salario.ToString("N0")</div>
    </div>
  </div>
  <div class="row padding">
    <div class="row">
      <div><b>Eps:</b> @Model.general.eps</div>
      <div class="text-right">
        @if(@Model.general.afp != ""){<b>Fondo de pensión:</b> @Model.general.afp}
      </div>
    </div>
    <div class="row">
      <div><b>E-mail:</b> @Model.empleado.Dir_Elec</div>
    </div>
    <div class="row">
      <div><b>Banco:</b> @Model.general.banco</div>
      <div class="text-right"><b>Cuenta N°:</b> @Model.empleado.Num_Cta</div>
    </div>
  </div>
  <div class="row">
    <table style="width: 100%;">
      <thead>
      <th style='text-align: center;'>Cod</th>
      <th style='text-align: left;'>Concepto</th>
      <th>Días</th>
      <th>Horas</th>
      <th>Devengados</th>
      <th>Deducidos</th>
      <th>% Desc.</th>
      </thead>
      <tbody>
        jeanca
        @{ double totalDevengos = 0, totalDeducidos = 0; }
        @foreach (var registro in Model.pagos)
        {
        <tr>
          <td class="text-center">@registro.Cod_Concepto</td>
          <td class="text-left">@registro.Nom_Concepto</td>
          <td>@registro.Dias_Novedad.ToString("N0")</td>
          <td>@registro.Horas_novedad.ToString("N")</td>
          @if (registro.Devengo == "S"){
          totalDevengos += registro.Valor_Novedad;
          <td>$@registro.Valor_Novedad.ToString("N0")</td>
          <td>0</td>
          }else if (registro.Devengo == "P" && registro.Valor_Novedad > 0){
          totalDevengos += registro.Valor_Novedad;
          <td>$@registro.Valor_Novedad.ToString("N0")</td>
          <td>0</td>
          }else if (registro.Devengo == "P" && registro.Valor_Novedad < 0){
          totalDeducidos -= registro.Valor_Novedad;
          <td>0</td>
          <td>$@(registro.Valor_Novedad*-1)</td>
          }else{
          totalDeducidos += registro.Valor_Novedad;
          <td>0</td>
          <td>$@registro.Valor_Novedad.ToString("N0")</td>
          }
          @if(registro.Cod_Concepto == 5){
          <td>@Model.empleado.Por_Retefuente.ToString("N")</td>
          }else if(registro.Cod_Concepto == 6){
          <td>@Model.aporteSalud.ToString("N")</td>
          } else if(registro.Cod_Concepto == 7){
          <td>@Model.aportePension.ToString("N")</td>
          } else if(registro.Cod_Concepto == 11){
          <td>@Model.PorSolPen.ToString("N")</td>
          }else{
          <td></td>
          }
        </tr>
        }
        <tr>
          <td colspan="4" style="text-align: right;"><b>Totales:</b></td>
          <td>$@totalDevengos.ToString("N0")</td>
          <td>$@totalDeducidos.ToString("N0")</td>
          <td></td>
        </tr>
        <tr>
          <td colspan="4" style="text-align: right;"><b>Neto a pagar:</b></td>
          <td>$@((totalDevengos - totalDeducidos).ToString("N0"))</td>
          <td></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>
  @{ double totalOtrosDevengos = 0; }
  @if (@Model.otrosPagos.Count() != 0){
  <div class="row" style="margin-top: 20px;">
    <div><h4>Beneficios Salariales</h4></div>
  </div>
  <div class="row">
    <table style="width: 50%; margin-top:0;">
      <thead>
      <th style='text-align: left;'>Concepto</th>
      <th>Valor</th>
      </thead>
      <tbody>
        @foreach (var registro in Model.otrosPagos)
        {
        <tr>
          @{ totalOtrosDevengos += registro.Valor_Novedad; }
          <td class="text-left">@registro.Nom_Concepto</td>
          <td>$@registro.Valor_Novedad.ToString("N0")</td>
        </tr>
        }
        <tr>
          <td class="text-right"><b>Total Beneficios:</b></td>
          <td>$@totalOtrosDevengos.ToString("N0")</td>
        </tr>
      </tbody>
    </table>
  </div>

  }


  <div class="row padding" style="margin: 100px 0;">
    <div style="width: 25%;padding: 20px; border-top: 1px solid #000">Firma Empleado:</div>
    <div>&nbsp;</div>
    <div style="width: 25%;padding: 20px; border-top: 1px solid #000">Revisado Por:</div>
    <div>&nbsp;</div>
  </div>






  <div class="row">
    <table style="width: 100%;">
      <thead>
      <th style='text-align: center;'>Cod</th>
      <th style='text-align: left;'>Concepto</th>
      <th>Días</th>
      <th>Horas</th>
      <th>Devengados</th>
      <th>Deducidos</th>
      <th>% Desc.</th>
      </thead>
      <tbody>
        @{ double totalDevengos = 0, totalDeducidos = 0; }
        @foreach (var registro in Model.bonificationsNonSalarial)
        {
        <tr>
          <td class="text-center">@registro.Cod_Concepto</td>
          <td class="text-left">@registro.Nom_Concepto</td>
          <td>@registro.Dias_Novedad.ToString("N0")</td>
          <td>@registro.Horas_novedad.ToString("N")</td>
          @if (registro.Devengo == "S"){
          totalDevengos += registro.Valor_Novedad;
          <td>$@registro.Valor_Novedad.ToString("N0")</td>
          <td>0</td>
          }else if (registro.Devengo == "P" && registro.Valor_Novedad > 0){
          totalDevengos += registro.Valor_Novedad;
          <td>$@registro.Valor_Novedad.ToString("N0")</td>
          <td>0</td>
          }else if (registro.Devengo == "P" && registro.Valor_Novedad < 0){
          totalDeducidos -= registro.Valor_Novedad;
          <td>0</td>
          <td>$@(registro.Valor_Novedad*-1)</td>
          }else{
          totalDeducidos += registro.Valor_Novedad;
          <td>0</td>
          <td>$@registro.Valor_Novedad.ToString("N0")</td>
          }
          @if(registro.Cod_Concepto == 5){
          <td>@Model.empleado.Por_Retefuente.ToString("N")</td>
          }else if(registro.Cod_Concepto == 6){
          <td>@Model.aporteSalud.ToString("N")</td>
          } else if(registro.Cod_Concepto == 7){
          <td>@Model.aportePension.ToString("N")</td>
          } else if(registro.Cod_Concepto == 11){
          <td>@Model.PorSolPen.ToString("N")</td>
          }else{
          <td></td>
          }
        </tr>
        }
        <tr>
          <td colspan="4" style="text-align: right;"><b>Totales:</b></td>
          <td>$@totalDevengos.ToString("N0")</td>
          <td>$@totalDeducidos.ToString("N0")</td>
          <td></td>
        </tr>
        <tr>
          <td colspan="4" style="text-align: right;"><b>Neto a pagar:</b></td>
          <td>$@((totalDevengos - totalDeducidos).ToString("N0"))</td>
          <td></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>
  @{ double totalOtrosDevengos = 0; }
  @if (@Model.otrosPagos.Count() != 0){
  <div class="row" style="margin-top: 20px;">
    <div><h4>Beneficios Salariales</h4></div>
  </div>
  <div class="row">
    <table style="width: 50%; margin-top:0;">
      <thead>
      <th style='text-align: left;'>Concepto</th>
      <th>Valor</th>
      </thead>
      <tbody>
        @foreach (var registro in Model.otrosPagos)
        {
        <tr>
          @{ totalOtrosDevengos += registro.Valor_Novedad; }
          <td class="text-left">@registro.Nom_Concepto</td>
          <td>$@registro.Valor_Novedad.ToString("N0")</td>
        </tr>
        }
        <tr>
          <td class="text-right"><b>Total Beneficios:</b></td>
          <td>$@totalOtrosDevengos.ToString("N0")</td>
        </tr>
      </tbody>
    </table>
  </div>

  }








  <p class="text-center">APORTES PAGADOS A LA SEGURIDAD SOCIAL NOMINA: @Model.general.ultimaFecNomina.ToString("yyyy/MM/dd") <br> <small>LEY 1393 JULIO 12 DE 2010, ARTICULO 32</small></p>

  <div class="row text-center">
    <table style="width: 80%; margin: 0 auto;">
      <thead>
      <th class="text-left">Concepto</th>
      <th>Días</th>
      <th>Valor IBC</th>
      <th> Valor Aporte</th>
      </thead>
      <tbody>
        @foreach (var registro in Model.aportes)
        {
        <tr>
          <td class="text-left">@registro.Nom_Concepto</td>
          <td>@registro.Dias_Novedad.ToString("N0")</td>
          <td>$@registro.Val_IBC.ToString("N0")</td>
          <td>$@registro.Val_Novedad.ToString("N0")</td>
        </tr>
        }
      </tbody>
    </table>
  </div>


</body>
</html>
