<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Comprobante de pago</title>
  <style>
    body{
      font-family: "Arial";
      margin: 0;
      font-size: 14px;
      padding-bottom: 0;
      text-rendering: geometricPrecision;
    }
    .row .row{
      display: table;
    }

    .row {
      display: table;
      width: 100%;
    }
    .row div{
      display: table-cell;
      vertical-align: middle;
    }
    .row.padding{
      padding: 10px 0;
    }
    table{
      margin-top: 40px;
      border-collapse: collapse;
      border: 1px solid #ccc
      font-size: 14px;
      text-align: right;
    }
    tr:nth-child(odd) {
      background-color: rgba(0,0,0,.05);
    }
    thead{
      background-color: #eef;
      font-weight: normal;
    }
    table th, table td{
      padding: 5px;
      border: 1px solid #ccc;
      vertical-align: middle;
    }
    .text-center{
      text-align: center;
    }
    .text-left{
      text-align: left;
    }
    .text-right{
      text-align: right;
    }
    hr{
      margin: 40px;
    }
    img{
      max-width: 100%;
    }
  </style>
</head>
<body class="row">

  <div class="row">
    <div style="page-break-before: always; padding: 30px;width: 35%; vertical-align: top">
      <div style="width: 200px;text-align: center;">
        <img src="@Model.general.logo" style="width: 200px">
      </div>
    </div>
    <div style=" padding-top: 30px;">
      <b>@Model.general.razonSocial</b><br><br>
      <b>NIT: @Model.general.nit</b><br><br>
      <b>NÓMINA   DE @Model.general.fechaNominaActual.ToString("MMMM").ToUpper() 1 DE @Model.general.fechaNominaActual.ToString("yyyy") A @Model.general.fechaNominaActual.ToString("MMMM dd").ToUpper() DE @Model.general.fechaNominaActual.ToString("yyyy")</b><br><br>
      <b>NOMBRE  DEL EMPLEADO: @Model.empleado.Cod_Empleado - @Model.empleado.Empleado </b><br><br>
      <b>DOC IDENTIFICACIÓN: @Model.empleado.Cedula</b><br><br>
      <b>CARGO: @Model.general.cargo </b> <br><br>
      @if(@Model.empleado.Por_Retefuente != 0){
          <b>PORCENTAJE DE RETENCIÓN EN LA FUENTE: @Model.empleado.Por_Retefuente.ToString("N0"); </b><br><br>
          <b>METODO DE RETENCIÓN EN LA FUENTE: @Model.empleado.MetodoRetefuente</b><br><br>
      }
      <b>EPS: @Model.general.eps</b><br><br>
      @if(@Model.general.afp != ""){<b>FONDO DE PENSIÓN: @Model.general.afp</b><br><br>}
      <b>E-MAIL: @Model.empleado.Dir_Elec</b><br><br>
    </div>
  </div>
  
  <div class="row">
    <table style="width: 100%;">
      <thead>
        <th style='text-align: center;'>COD</th>
        <th style='text-align: left;'>CONCEPTO</th>
        <th>DEVENGOS</th>
        <th>DEDUCCIONES</th>
      </thead>
      <tbody>
        @{ double totalDevengos = 0, totalDeducidos = 0; }
        @foreach (var registro in Model.pagos)
        {
          <tr>
            <td class="text-center">@registro.Cod_Concepto</td>
            <td class="text-left">@registro.Nom_Concepto</td>
            @if (registro.Devengo == "S"){
              totalDevengos += registro.Valor_Novedad;
              <td>$@registro.Valor_Novedad.ToString("N0")</td>
              <td>0</td>
            }else if (registro.Devengo == "P" && registro.Valor_Novedad > 0){
              totalDevengos += registro.Valor_Novedad;
              <td>$@registro.Valor_Novedad.ToString("N0")</td>
              <td>0</td>
            }else if (registro.Devengo == "P" && registro.Valor_Novedad < 0){
              totalDeducidos -= registro.Valor_Novedad;
              <td>0</td>
              <td>$@(registro.Valor_Novedad*-1)</td>
            }else{
              totalDeducidos += registro.Valor_Novedad;
              <td>0</td>
              <td>$@registro.Valor_Novedad.ToString("N0")</td>
            }
            
          </tr>
        }
        <tr>
          <td colspan="2"  style="text-align: right;"><b>TOTALES:</b></td>
          <td>$@totalDevengos.ToString("N0")</td>
          <td>$@totalDeducidos.ToString("N0")</td>
        </tr>
        <tr>
          <td colspan="2"  style="text-align: right;"><b>NETO A PAGAR:</b></td>
          <td >$@((totalDevengos - totalDeducidos).ToString("N0"))</td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>


  <div class="row padding" style="margin: 100px 0; margin-bottom: 50px;">
    <div>&nbsp;</div>
    <div>&nbsp;</div>
    <div style="width: 25%;padding: 20px; border-top: 1px solid #000">Firma:</div>
    <div>&nbsp;</div>
  </div>



  <p style="page-break-before: always;padding: 30px" class="text-center">APORTES PAGADOS A LA SEGURIDAD SOCIAL NOMINA: @Model.general.ultimaFecNomina.ToString("yyyy/MM/dd") <br> <small>LEY 1393 JULIO 12 DE 2010, ARTICULO 32</small></p>

  <div class="row text-center">
    <table style="width: 80%; margin: 0 auto;">
      <thead>
        <th class="text-left">Concepto</th>
        <th>Días</th>
        <th>Valor IBC</th>
        <th> Valor Aporte</th>
      </thead>
      <tbody>
        @foreach (var registro in Model.aportes)
        {
        <tr>
          <td class="text-left">@registro.Nom_Concepto</td>
          <td>@registro.Dias_Novedad.ToString("N0")</td>
          <td>$@registro.Val_IBC.ToString("N0")</td>
          <td>$@registro.Val_Novedad.ToString("N0")</td>
        </tr>
        }
      </tbody>
    </table>
  </div>


</body>
</html>
